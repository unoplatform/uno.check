<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The reader half of the structured output contract (spec 003), packaged for hosts that
    drive uno-check and parse its JSONL stream. The CLI writes the contract; this writes
    nothing and runs nothing — it only builds command lines and turns lines into events, so
    every host does not reimplement the same parsing.

    netstandard2.0 keeps older hosts (and the CLI itself, which still targets up to net6.0)
    able to consume it; net8.0 adds source-generated serialization for trimmed consumers.
  -->

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable Condition="'$(TargetFramework)'!='netstandard2.0'">true</IsTrimmable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Uno.Check.Client</PackageId>
    <Description>Client for the uno-check structured output contract: builds its command lines and parses its JSONL event stream. For tools that drive uno-check; does not include the checks themselves.</Description>
    <PackageTags>uno;uno-check;diagnostics;environment</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
